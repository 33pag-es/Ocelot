# Copy to .env on the tracker server. docker-compose.prod.yml reads it for
# port bindings and passes it to the container through env_file.
#
# OCELOT_MYSQL_USER/OCELOT_MYSQL_PASSWORD must match the site server's
# Gazelle .env. TRACKER_SECRET and TRACKER_REPORTKEY must each be exactly 32
# characters and match lib/override.config.php on the site server.

# Site server over WireGuard.
MYSQL_HOST=10.33.0.1
MYSQL_DATABASE=gazelle
OCELOT_MYSQL_USER=ocelot
OCELOT_MYSQL_PASSWORD=change-me
# Gazelle's freeleech-token callback: GAZELLE_TUNNEL_IP and
# GAZELLE_TUNNEL_PORT in the site server's .env.
GAZELLE_HOST=10.33.0.1
GAZELLE_PORT=8080

TRACKER_SECRET=change-me-32-characters-00000000
TRACKER_REPORTKEY=change-me-32-characters-00000000

# This server's WireGuard address. Gazelle calls Ocelot here, and it must
# match TRACKER_HOST in the site server's override.config.php.
TRACKER_TUNNEL_IP=10.33.0.2
# Caddy on this host proxies the public announce URL to TRACKER_BIND:34000.
TRACKER_BIND=127.0.0.1

# Ocelot trusts X-Forwarded-For. Leave 0 behind Caddy on loopback. Set 1 only
# if port 34000 is published directly to clients.
OCELOT_IGNORE_XFF=0

# Optional prebuilt image instead of building this checkout.
# OCELOT_IMAGE=registry.example.com/ocelot:prod
