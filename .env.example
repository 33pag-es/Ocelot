# Copy to .env. This file is consumed by docker-compose.prod.yml through
# env_file, so it applies when the Ocelot overlay is merged with the Gazelle
# production stack.
#
# Keep OCELOT_MYSQL_USER/OCELOT_MYSQL_PASSWORD, TRACKER_SECRET, and
# TRACKER_REPORTKEY identical to the values in Gazelle-33/.env.example and
# lib/override.config.php. TRACKER_SECRET and TRACKER_REPORTKEY must each be
# exactly 32 characters.

MYSQL_DATABASE=gazelle
OCELOT_MYSQL_USER=ocelot
OCELOT_MYSQL_PASSWORD=change-me

TRACKER_SECRET=change-me-32-characters-00000000
TRACKER_REPORTKEY=change-me-32-characters-00000000
