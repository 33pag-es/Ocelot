# Production Ocelot configuration template.
# entrypoint-prod.sh replaces @...@ placeholders with values from the
# container environment. The generated file lives on tmpfs, not in git.

listen_port = 34000
max_connections = 512
max_middlemen = 10000
max_read_buffer = 4096
connection_timeout = 10
keepalive_timeout = 0

announce_interval = 1800
announce_jitter = 240
max_request_size = 4096
numwant_limit = 50
request_log_size = 500

mysql_host = @MYSQL_HOST@
mysql_port = 3306
mysql_username = @MYSQL_USER@
mysql_password = @MYSQL_PASSWORD@
mysql_db = @MYSQL_DATABASE@

report_password = @REPORT_PASSWORD@
site_password = @SITE_PASSWORD@

# Gazelle's freeleech-token callback (tools.php?action=ocelot), over the
# WireGuard tunnel. site_service is the port number.
site_host = @GAZELLE_HOST@
site_service = @GAZELLE_PORT@

peers_timeout = 7200
del_reason_lifetime = 86400
reap_peers_interval = 1800
schedule_interval = 3

log = false
log_path = /tmp/ocelot
report_path = /tmp/ocelot

readonly = false
